# Postgres (docker compose maps to 5433)
DATABASE_URL=postgres://chatboat:chatboat@localhost:5433/chatboat
# Read-only role the AI uses to query the demo business data (created by migrate)
ANALYST_DATABASE_URL=postgres://analyst_ro:analyst_ro@localhost:5433/chatboat

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# AI provider: anthropic | openai | google | nvidia | azure | bedrock | openai-compatible
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5          # optional for most providers; required for azure and openai-compatible
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# NVIDIA NIM (build.nvidia.com). Example: AI_PROVIDER=nvidia AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=

# Private AI options (data stays in your cloud or on your servers). Set only the one you use.
# Azure OpenAI: AI_PROVIDER=azure, AI_MODEL=<your deployment name>
# AZURE_RESOURCE_NAME=               # the <name> in https://<name>.openai.azure.com
# AZURE_API_KEY=
# Amazon Bedrock: AI_PROVIDER=bedrock, AI_MODEL defaults to us.anthropic.claude-opus-5-5
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=                 # with AWS_SECRET_ACCESS_KEY (and optional AWS_SESSION_TOKEN)...
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=          # ...or a Bedrock API key instead
# Self-hosted vLLM / Ollama / any OpenAI-compatible server: AI_PROVIDER=openai-compatible, AI_MODEL=<served model name>
# AI_BASE_URL=http://localhost:11434/v1   # Ollama; vLLM is usually http://<host>:8000/v1
# AI_API_KEY=                        # only if your server requires one

API_PORT=4000

# Email for scheduled digests. Locally this points at Mailpit (docker compose), a fake
# inbox at http://localhost:8025. In production use your provider's SMTP URL.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Chatboat <digests@chatboat.local>"

# Limits and cost tracking
DAILY_QUESTION_LIMIT=100          # questions per user per day (UTC)
AI_PRICE_INPUT_PER_M=0            # $ per million input tokens, for cost estimates (0 = don't estimate)
AI_PRICE_OUTPUT_PER_M=0           # $ per million output tokens
# DISABLE_SCHEDULER=1             # set on API instances that shouldn't send digests

# Only for docker-compose.prod.yml
# PUBLIC_URL=https://chatboat.example.com
# POSTGRES_PASSWORD=change-me
# ANALYST_PASSWORD=change-me-too

# Encrypts saved database passwords for connected data sources. Generate with:
#   openssl rand -hex 32
# Changing it later means re-entering those passwords.
DATA_ENCRYPTION_KEY=
