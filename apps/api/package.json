{
  "name": "@chatboat/api",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start:dist": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=../../.env evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.134",
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/azure": "^4.0.118",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/openai-compatible": "^3.0.86",
    "@chatboat/db": "workspace:*",
    "@chatboat/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^7.0.164",
    "better-auth": "^1.7.18",
    "cron-parser": "^5.10.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
