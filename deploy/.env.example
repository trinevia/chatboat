# Reference for deploy/.env. install.sh writes the real file with generated secrets.
# Single-quote values: they are taken literally (no $ expansion).

CHATBOAT_VERSION='1.0.0'            # image tag; upgrade.sh changes it
# CHATBOAT_REGISTRY='ghcr.io/trinevia'
DOMAIN='chat.example.com'
PUBLIC_URL='https://chat.example.com'
ACME_EMAIL='it@example.com'          # Let's Encrypt expiry notices
HTTP_PORT='80'
HTTPS_PORT='443'

# Generated by install.sh (openssl rand). Never change them on a running install.
BETTER_AUTH_SECRET=''
DATA_ENCRYPTION_KEY=''
POSTGRES_PASSWORD=''
ANALYST_PASSWORD=''

SMTP_URL='smtps://user:password@smtp.example.com:465'
MAIL_FROM='Chatboat <chatboat@chat.example.com>'

# anthropic | openai | google | nvidia | azure | bedrock | openai-compatible
AI_PROVIDER='anthropic'
AI_MODEL=''                          # empty = provider default
ANTHROPIC_API_KEY=''
# OPENAI_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY / NVIDIA_API_KEY
# AZURE_RESOURCE_NAME / AZURE_API_KEY
# AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# AI_BASE_URL / AI_API_KEY
DAILY_QUESTION_LIMIT='100'
# AI_PRICE_INPUT_PER_M='0'
# AI_PRICE_OUTPUT_PER_M='0'

# Backups: nightly pg_dump into ./backups
BACKUP_TIME='02:30'                  # HH:MM, UTC (set TZ='Europe/Berlin' to change)
BACKUP_KEEP_DAYS='14'
# Optional copy to S3-compatible storage (Hetzner Object Storage, AWS S3, R2, MinIO...)
BACKUP_S3_ENDPOINT=''                # e.g. https://fsn1.your-objectstorage.com; empty for AWS
BACKUP_S3_REGION=''
BACKUP_S3_BUCKET=''
BACKUP_S3_ACCESS_KEY_ID=''
BACKUP_S3_SECRET_ACCESS_KEY=''
# BACKUP_S3_PREFIX='chatboat'
# BACKUP_S3_KEEP_DAYS='30'
